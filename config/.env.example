# Database Configuration
# SQLAlchemy database URL - replace with your actual database connection string
# Examples:
# PostgreSQL: postgresql://username:password@localhost:5432/database_name
# MySQL: mysql+pymysql://username:password@localhost:3306/database_name
# SQLite: sqlite:///path/to/database.db
DB_URL=

# LLM Provider Configuration
# Choose your LLM provider: 'ollama' or 'openai'
# Switch to OpenAI (Azure OpenAI-compatible) by setting LLM_PROVIDER=openai
LLM_PROVIDER=openai

# === Ollama Configuration (Local LLM) ===
# Use these settings if LLM_PROVIDER=ollama
# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434
# Model to use for analysis (examples: llama3, llama3.1, mistral, codellama, gemma)
OLLAMA_MODEL=llama3

# === OpenAI-Compatible API Configuration ===
# Use these settings if LLM_PROVIDER=openai
# Works with OpenAI, Azure OpenAI, or any OpenAI-compatible API
OPENAI_API_KEY=your_api_key_here

# Azure OpenAI (example):
# For deployment 'gpt-4o-mini' at resource 'statista-productai', set:
# Endpoint root (no trailing path):
OPENAI_BASE_URL=https://statista-productai.openai.azure.com/
# Deployment/model name to call
OPENAI_MODEL=gpt-4o-mini
# API version for Azure OpenAI
OPENAI_API_VERSION=2025-01-01-preview

# Alternative OpenAI-compatible endpoints:
# OPENAI_BASE_URL=https://api.openai.com/v1               # OpenAI
# OPENAI_BASE_URL=https://api.anthropic.com/v1            # Claude API
# OPENAI_BASE_URL=https://api.together.xyz/v1             # Together AI
# OPENAI_BASE_URL=https://api.groq.com/openai/v1          # Groq

# === LLM Concurrency Settings ===
# Maximum concurrent requests to LLM API (adjust based on your rate limits)
LLM_MAX_CONCURRENT=5

# Minimum delay between requests in seconds (helps prevent rate limiting)
LLM_REQUEST_DELAY=0.1

# === Logging Settings ===
# Set to true to enable detailed logging for debugging
LLM_DEBUG_LOGGING=false

# News API Configuration
# Set to true to enable news sentiment analysis features
NEWS_API_ENABLED=false

# Minimum articles required per country to use news analysis
# Below this threshold, only indicators will be used for adjustments
NEWS_ARTICLE_THRESHOLD=10

# Optional: News API credentials (if using external news services)
# NEWS_API_KEY=
# NEWS_API_URL=

# GDELT SSL Configuration
# Controls TLS certificate verification for GDELT API connections.
# SECURITY: Keep this true in production. Set to false only for
# troubleshooting behind trusted networks when the GDELT endpoint has
# certificate issues. When false, requests to *.gdeltproject.org will
# skip SSL verification and a warning will be logged.
GDELT_SSL_VERIFY=false

# Application Settings
# Default years for historical analysis
DEFAULT_HIST_CUTOFF=2020
DEFAULT_FORECAST_UNTIL=2025

# Forecasting Configuration
# Default forecasting method: baseline, arima, ensemble
DEFAULT_FORECAST_METHOD=baseline

# Enable debug mode for development
DEBUG_MODE=false
